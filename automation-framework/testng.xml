<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="ShopSphereSuite">
    <listeners>
        <listener class-name="com.shopsphere.qa.listeners.TestListener" />
    </listeners>
    <test name="Smoke">
        <classes>
            <class name="com.shopsphere.qa.tests.LoginTests" />
            <class name="com.shopsphere.qa.tests.ProductTests" />
            <class name="com.shopsphere.qa.tests.CartTests" />
            <class name="com.shopsphere.qa.tests.CheckoutTests" />
            <class name="com.shopsphere.qa.tests.NegativeTests" />
            <class name="com.shopsphere.qa.tests.AdminLoginTests" />
        </classes>
    </test>
</suite>
